# Copia a .env.local. Para el demo con los CASOS DE MUESTRA no necesitas ninguna key.

# --- Motor LLM (análisis + sparring) vía OpenRouter — una sola key ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5    # o anthropic/claude-opus-4.1, openai/gpt-4o, etc.

# --- Voz del adversario en el Sparring (opcional; sin esto usa la voz del navegador) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB        # voz válida en tier gratis (Adam)

# --- Anonimización: gateway Presidio NER local (opcional; sin esto usa el regex local) ---
PRESIDIO_URL=                                   # ej. http://localhost:8088 (ver presidio/README.md)

# --- RAG (opcional, solo cuando escales a expedientes enormes o cartera) ---
OPENAI_API_KEY=                                 # mitad vectorial del RAG (embeddings). Sin esto, RAG cae a BM25
PINECONE_API_KEY=                               # indexar cartera (muchos casos) en Pinecone
